# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
# OPENAI_API_KEY=
SLACK_WEBHOOK_URL=
DATABASE_URL=postgresql://postgres@localhost:5432/regintel
# required by the API so row-level security applies (see sql/007_rls.sql)
# DATABASE_URL_APP=postgresql://regintel_app:password@localhost:5432/regintel

# Google sign in (optional). Create an OAuth client at console.cloud.google.com
# Authorised redirect URI: http://localhost:3100/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# shared secret between the Next route and the API
OAUTH_SHARED_SECRET=
APP_BASE_URL=http://localhost:3100

# set to true to bypass sign in for local demos
# AUTH_DISABLED=true
